# Production environment for the Buildtruck API.
# Install on the server as /etc/buildtruck/api.env (owner root:deploy, mode 640).
# Never commit the real file.

NODE_ENV=production

# Only nginx on the same machine talks to the API.
HOST=127.0.0.1
PORT=5000
# nginx is one proxy hop in front of the API. Required in production: it makes the API
# read the real client IP from X-Forwarded-For for login rate limiting.
TRUST_PROXY=1

# Password of the timetrack role. Percent-encode it if it contains @ : / ? # % or spaces.
DATABASE_URL=postgresql://timetrack:CHANGE_ME@127.0.0.1:5432/timetrack_db
DB_POOL_MAX=10

# Generate with `openssl rand -base64 48`. Changing it signs everyone out.
JWT_SECRET=CHANGE_ME

# Exact origin(s) of the admin dashboard, comma-separated, no trailing slash.
CORS_ORIGINS=https://admin.example.com

# Timezone of the building sites; decides the calendar day of each shift.
APP_TIMEZONE=Europe/Riga
