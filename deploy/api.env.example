# Production environment for the Buildtruck API.
# Install on the server as /etc/buildtruck/api.env (owner root:buildtruck, mode 640).
# Never commit the real file.

NODE_ENV=production

# Only nginx on the same machine talks to the API.
HOST=127.0.0.1
PORT=5000
# nginx is one proxy hop in front of the API (needed for per-client login rate limiting).
TRUST_PROXY=1

# Password: generate with `openssl rand -hex 24` (hex avoids URL-escaping problems).
DATABASE_URL=postgresql://buildtruck:CHANGE_ME@127.0.0.1:5432/buildtruck
DB_POOL_MAX=10

# Generate with `openssl rand -base64 48`. Changing it signs everyone out.
JWT_SECRET=CHANGE_ME

# Exact origin(s) of the admin dashboard, comma-separated, no trailing slash.
CORS_ORIGINS=https://admin.example.com

# Timezone of the building sites; decides the calendar day of each shift.
APP_TIMEZONE=Europe/Riga
