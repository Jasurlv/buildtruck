# Build settings for the admin dashboard. Copy to /etc/buildtruck/admin.env.
# Not secret: these values are baked into the JavaScript every browser downloads.
# deploy/update-admin.sh reads only NEXT_PUBLIC_* lines (KEY=value, no quotes) and
# applies them at build time; changing them needs a new build (run the script again).

# The API, with /api at the end. Must be https://.
NEXT_PUBLIC_API_URL=https://api.globaltimetrack.com/api

# Timezone of the building sites; must match APP_TIMEZONE in /etc/buildtruck/api.env.
NEXT_PUBLIC_APP_TIMEZONE=Europe/Riga
